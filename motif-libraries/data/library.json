    "mcp__research_report__submit_report_text": {
      "type": "object",
      "properties": {
        "packet_id": {
          "title": "Packet Id",
          "type": "string"
        },
        "report_text": {
          "$ref": "#/$defs/ReportText"
        }
      },
      "required": [
        "packet_id",
        "report_text"
      ],
      "$defs": {
        "ReportSection": {
          "additionalProperties": false,
          "description": "One body section, in the already approved order. No extra fields.",
          "properties": {
            "heading": {
              "description": "Copy the exact corresponding approved outline heading. Put scientific roles only in presentation.report.outline, not here.",
              "title": "Heading",
              "type": "string"
            },
            "paragraphs": {
              "description": "Write the complete body yourself. Bind ALL scientific numbers to available {{name}} tokens. Legal existing figure labels such as 图1/Figure 1 and consecutive list markers such as （1）…；（2）… are formatting. Do not write source hashes or paths in prose; they are retained automatically in sidecar records.",
              "items": {
                "maxLength": 2000,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 12,
              "minItems": 1,
              "title": "Paragraphs",
              "type": "array"
            },
            "figure_indices": {
              "description": "Required zero-based indexes of actual approved figures placed in this section. Use [] if none. Across all sections include every actual figure exactly once. Body references 图1/Figure 1 use one-based labels.",
              "items": {
                "minimum": 0,
                "type": "integer"
              },
              "title": "Figure Indices",
              "type": "array"
            }
          },
          "required": [
            "heading",
            "paragraphs",
            "figure_indices"
          ],
          "title": "ReportSection",
          "type": "object"
        },
        "ReportText": {
          "additionalProperties": false,
          "description": "Full model-written body, not a template or permission to invent numbers.",
          "properties": {
            "sections": {
              "description": "Exactly the approved headings in order. Write methods, results, interpretation, diagnostics and limitations. Across the body use {{estimate}},{{ci_low}},{{ci_high}},{{p_value}},{{n}},{{excluded_rows}}. State synthetic-data limitations when source metadata says synthetic and state that this analysis does not establish causality. Use {{confidence_pct}}%, {{null_value}} and {{unit_increment}} instead of literal confidence/zero/unit-count numbers.",
              "items": {
                "$ref": "#/$defs/ReportSection"
              },
              "maxItems": 10,
              "minItems": 1,
              "title": "Sections",
              "type": "array"
            },
            "allow_deterministic_continuation": {
              "description": "REQUIRED explicit JSON boolean, no default. true authorizes assembly, layout and verification of THIS submitted text; false leaves continuation to the model. It never authorizes changing scientific prose.",
              "title": "Allow Deterministic Continuation",
              "type": "boolean"
            },
            "research_options": {
              "description": "Supply at least the returned research_options_min when the user requests alternative studies; otherwise may omit. These model-written fields are inserted into an existing approved next_steps/limitations section.",
              "items": {
                "$ref": "#/$defs/ResearchOption"
              },
              "maxItems": 4,
              "title": "Research Options",
              "type": "array"
            },
            "comparison_summary": {
              "anyOf": [
                {
                  "maxLength": 2000,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Required when research_options is nonempty: compare their objectives and trade-offs using actual evidence; all scientific numbers use {{name}} tokens. Otherwise omit this field or put ordinary discussion in sections.",
              "title": "Comparison Summary"
            }
          },
          "required": [
            "sections",
            "allow_deterministic_continuation"
          ],
          "title": "ReportText",
          "type": "object"
        },
        "ResearchOption": {
          "additionalProperties": false,
          "description": "An LLM-written study choice; this schema does not judge its merit.",
          "properties": {
            "name": {
              "description": "A distinct research/sampling option name; do not add fields beyond name,rationale,tradeoff.",
              "maxLength": 2000,
              "minLength": 1,
              "title": "Name",
              "type": "string"
            },
            "rationale": {
              "description": "Explain why this option serves the actual findings/question. All quantitative values use verified {{name}} tokens.",
              "maxLength": 2000,
              "minLength": 1,
              "title": "Rationale",
              "type": "string"
            },
            "tradeoff": {
              "description": "Explain costs, assumptions and limitations; describe untested scientific benefits as conditional hypotheses.",
              "maxLength": 2000,
              "minLength": 1,
              "title": "Tradeoff",
              "type": "string"
            }
          },
          "required": [
            "name",
            "rationale",
            "tradeoff"
          ],
          "title": "ResearchOption",
          "type": "object"
        }
      },
      "title": "submit_report_textArguments"
    },
    "mcp__research_report__verify_analysis": {
      "type": "object",
      "properties": {
        "analysis_id": {
          "title": "Analysis Id",
          "type": "string"
        }
      },
