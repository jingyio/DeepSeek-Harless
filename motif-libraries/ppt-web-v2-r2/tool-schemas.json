            "properties": {
              "page": {
                "type": "integer",
                "minimum": 1,
                "maximum": 30
              },
              "slide": {
                "type": "object"
              }
            }
          }
        },
        "deletions": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30
          }
        },
        "insertions": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "object",
            "required": [
