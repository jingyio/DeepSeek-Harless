          "minLength": 1,
          "maxLength": 500
        },
        "metadata": {
          "type": "object"
        },
        "updates": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "object",
            "required": [
              "page",
              "changes"
            ],
            "properties": {
              "page": {
                "type": "integer",
                "minimum": 1,
                "maximum": 30
              },
              "changes": {
                "type": "object"
              }
            }
          }
        },
        "replacements": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "object",
            "required": [
              "page",
              "slide"
