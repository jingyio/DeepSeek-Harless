  {
    "name": "mcp__ppt__render_deck",
    "description": "Create a new cited editable PPTX. plan requires title and exactly the task slide count including cover. Failure may return a pending draft for explicit local repair in host_delivery.",
    "parameters": {
      "type": "object",
      "properties": {
        "plan": {
          "type": "object",
          "required": [
            "title",
            "slides"
          ],
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "template": {
              "type": "string",
              "enum": [
                "academic",
                "lab"
              ]
            },
            "slides": {
              "type": "array",
              "minItems": 6,
              "maxItems": 6,
              "items": {
                "type": "object",
                "required": [
                  "title",
                  "sources"
                ],
                "additionalProperties": false,
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 70
                  },
                  "bullets": {
                    "type": "array",
                    "maxItems": 5,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 150
                    }
                  },
                  "sources": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 20,
                    "items": {
                      "type": "object",
                      "required": [
                        "source_id",
                        "page"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "source_id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 500
                        },
                        "page": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 200
                        }
                      }
                    }
                  },
                  "notes": {
                    "type": "string",
                    "maxLength": 6000
                  },
                  "layout": {
                    "type": "string",
                    "enum": [
                      "title",
                      "content",
                      "image",
                      "table",
                      "chart",
                      "section",
                      "comparison",
                      "process"
                    ]
                  },
                  "image": {
                    "type": "object",
                    "required": [
                      "source_id",
                      "image_id"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "source_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 500
                      },
                      "image_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 500
                      }
                    }
                  },
                  "table": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 6,
                    "items": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 4,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 45
                      }
                    }
                  },
                  "chart": {
                    "type": "object"
                  },
                  "comparison": {
                    "type": "object"
                  },
                  "process": {
                    "type": "object"
                  },
                  "takeaway": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 90
                  },
                  "archetype": {
                    "type": "string",
                    "enum": [
                      "evidence-focus",
                      "result-summary",
                      "method-map"
                    ]
                  },
                  "evidence_notes": {
                    "type": "array",
                    "maxItems": 3,
                    "items": {
                      "type": "object",
                      "required": [
                        "label",
                        "text",
                        "source_index"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "label": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 24
                        },
                        "text": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 110
                        },
                        "source_index": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 20
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "required": [
        "plan"
      ],
      "additionalProperties": false
    }
  },
