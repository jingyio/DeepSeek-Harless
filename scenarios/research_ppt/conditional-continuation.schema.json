{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sss://research-ppt/conditional-continuation/v1",
  "$ref": "#/$defs/candidate",
  "$defs": {
    "sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 500, "pattern": "^[^\\u0000-\\u001f]+$"},
    "strings": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "hashes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/sha"}},
    "dependencies": {"type": "object", "minProperties": 1, "maxProperties": 40,
      "propertyNames": {"$ref": "#/$defs/text"}, "additionalProperties": {"$ref": "#/$defs/sha"}},
    "field": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$", "not": {"enum": ["constructor", "prototype", "__proto__"]}},
    "binding": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["from", "field"],
          "properties": {"from": {"enum": ["task", "anchor"]}, "field": {"$ref": "#/$defs/field"}}},
        {"type": "object", "additionalProperties": false, "required": ["from", "node_id", "field"],
          "properties": {"from": {"const": "node"}, "node_id": {"$ref": "#/$defs/text"}, "field": {"$ref": "#/$defs/field"}}}
      ]
    },
    "node": {"type": "object", "additionalProperties": false,
      "required": ["id", "tool", "bindings", "output_contract"],
      "properties": {"id": {"$ref": "#/$defs/text"},
        "tool": {"enum": ["mcp__ppt__pin_deck_pages", "mcp__ppt__read_pinned_deck_pages"]},
        "bindings": {"type": "object", "minProperties": 1, "maxProperties": 2, "additionalProperties": {"$ref": "#/$defs/binding"}},
        "output_contract": {"enum": ["pinned_pages", "read_pages"]}}},
    "candidate": {"type": "object", "additionalProperties": false,
      "required": ["schema_version", "primitive_version", "candidate_id", "origin", "candidate_digest", "anchor", "branches", "contracts", "dependencies", "training"],
      "properties": {
        "schema_version": {"const": 1}, "primitive_version": {"const": "ppt-conditional-read-v1"},
        "candidate_id": {"$ref": "#/$defs/text"}, "origin": {"enum": ["manual", "learned"]}, "candidate_digest": {"$ref": "#/$defs/sha"},
        "anchor": {"type": "object", "additionalProperties": false, "required": ["tool", "input_version_field", "predicate"],
          "properties": {"tool": {"enum": ["mcp__ppt__inspect_deck", "mcp__ppt__read_deck_plan", "mcp__ppt__pin_deck_pages", "mcp__ppt__read_pinned_deck_pages"]},
            "input_version_field": {"enum": ["input_version", "version_sha256"]},
            "predicate": {"type": "object", "additionalProperties": false, "required": ["op", "field", "value"],
              "properties": {"op": {"const": "field_equals"}, "field": {"$ref": "#/$defs/field"},
                "value": {"oneOf": [{"$ref": "#/$defs/text"}, {"type": "boolean"}, {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991}]}}}}},
        "branches": {"type": "object", "additionalProperties": false, "required": ["on_equal", "on_unequal"],
          "properties": {"on_equal": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/node"}},
            "on_unequal": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/node"}}}},
        "contracts": {"type": "object", "minProperties": 1, "maxProperties": 4,
          "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["read_only", "replay_stable", "input_schema"],
            "properties": {"read_only": {"const": true}, "replay_stable": {"const": true}, "input_schema": {"type": "object"}}}},
        "dependencies": {"$ref": "#/$defs/dependencies"},
        "training": {"type": "object", "additionalProperties": false, "required": ["task_fingerprints", "trace_sha256"],
          "properties": {"task_fingerprints": {"$ref": "#/$defs/strings"}, "trace_sha256": {"$ref": "#/$defs/hashes"}}}
      },
      "allOf": [{"if": {"properties": {"origin": {"const": "learned"}}},
        "then": {"properties": {"training": {"properties": {"task_fingerprints": {"minItems": 2}, "trace_sha256": {"minItems": 2}}}}}}]
    },
    "guard": {"type": "object", "additionalProperties": false,
      "required": ["schema_version", "session_id", "task_fingerprint", "input_version", "deck_id", "deck_sha256", "pages_csv", "job_sha256", "permission_sha256", "dependencies", "allowed_tools"],
      "properties": {"schema_version": {"const": 1}, "session_id": {"$ref": "#/$defs/text"}, "task_fingerprint": {"$ref": "#/$defs/text"},
        "input_version": {"$ref": "#/$defs/sha"}, "deck_id": {"$ref": "#/$defs/text"}, "deck_sha256": {"$ref": "#/$defs/sha"},
        "pages_csv": {"type": "string", "pattern": "^[1-9][0-9]?(?:,[1-9][0-9]?){0,29}$"},
        "job_sha256": {"$ref": "#/$defs/sha"}, "permission_sha256": {"$ref": "#/$defs/sha"},
        "dependencies": {"$ref": "#/$defs/dependencies"}, "allowed_tools": {"$ref": "#/$defs/strings", "minItems": 1}}},
    "admission": {"type": "object", "additionalProperties": false,
      "required": ["schema_version", "certifier", "status", "candidate_digest", "certificate_digest", "training_task_fingerprints", "validation_task_fingerprints", "validation_evidence_sha256", "branches_tested", "negative_cases"],
      "properties": {"schema_version": {"const": 1}, "certifier": {"const": "python-independent-v1"}, "status": {"const": "passed"},
        "candidate_digest": {"$ref": "#/$defs/sha"}, "certificate_digest": {"$ref": "#/$defs/sha"},
        "training_task_fingerprints": {"$ref": "#/$defs/strings"},
        "validation_task_fingerprints": {"$ref": "#/$defs/strings", "minItems": 1},
        "validation_evidence_sha256": {"$ref": "#/$defs/hashes", "minItems": 1},
        "branches_tested": {"type": "array", "uniqueItems": true, "minItems": 2, "maxItems": 2, "items": {"enum": ["on_equal", "on_unequal"]}},
        "negative_cases": {"type": "array", "uniqueItems": true, "minItems": 8, "maxItems": 8,
          "items": {"enum": ["missing_state", "conflicting_arguments", "permission_changed", "dependency_changed", "source_changed", "schema_changed", "tool_failure", "result_scope_changed"]}}}}
  }
}
