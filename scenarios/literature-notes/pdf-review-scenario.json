{
  "schema_version": 1,
  "name": "literature_pdf_review",
  "prompt": "pdf-review-task.md",
  "servers": [{
    "server_name": "literature_pdf_review",
    "transport": "stdio",
    "command": "${PYTHON}",
    "args": ["${PROJECT_ROOT}/scenarios/literature-notes/pdf_review_tools.py"],
    "cwd": "${PROJECT_ROOT}",
    "env": {
      "SSS_PDF_REVIEW_RUN": {"from_env": "SSS_PDF_REVIEW_RUN"},
      "SSS_PDF_REVIEW_OUTPUT": {"from_env": "SSS_PDF_REVIEW_OUTPUT"}
    }
  }],
  "allowed_tools": [
    "mcp__literature_pdf_review__read_review_packet",
    "mcp__literature_pdf_review__read_review_evidence",
    "mcp__literature_pdf_review__submit_claim_review"
  ]
}
