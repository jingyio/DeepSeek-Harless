{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Model-selected parameter continuation v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_sha256",
    "library_digest",
    "motif_id",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "catalog_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "library_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "motif_id": {
      "type": "string",
      "minLength": 1
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "item_id",
              "file_path",
              "sha256"
            ],
            "properties": {
              "item_id": {
                "type": "string",
                "minLength": 1
              },
              "file_path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "item_id",
              "id",
              "source_path"
            ],
            "properties": {
              "item_id": {
                "type": "string",
                "minLength": 1
              },
              "id": {
                "type": "string",
                "pattern": "^[0-9]{4}\\.[0-9]{4,5}(v[0-9]+)?$"
              },
              "source_path": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "item_id",
              "query",
              "source_path"
            ],
            "properties": {
              "item_id": {
                "type": "string",
                "minLength": 1
              },
              "query": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "source_path": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      }
    }
  }
}
