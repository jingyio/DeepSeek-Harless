{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "只读产物续接 Shadow 候选库",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scope", "execution_policy", "motifs", "source_traces", "tool_schema_sha256", "validator_code_sha256", "limitations", "manifest_digest"],
  "properties": {
    "schema_version": {"const": 1},
    "scope": {"const": "artifact_continuation_shadow_probe"},
    "execution_policy": {"const": "shadow_only"},
    "manifest_digest": {"$ref": "#/$defs/hash"},
    "source_traces": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "object"}},
    "tool_schema_sha256": {"$ref": "#/$defs/hashes"},
    "validator_code_sha256": {"$ref": "#/$defs/hashes"},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "motifs": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["motif_id", "graph", "training_witnesses", "training_session_count", "support", "status"],
        "properties": {
          "motif_id": {"type": "string", "pattern": "^paper-shadow-[a-f0-9]{12}$"},
          "graph": {"type": "object"},
          "training_witnesses": {"type": "array", "minItems": 1, "items": {"type": "object"}},
          "training_session_count": {"type": "integer", "minimum": 1},
          "support": {"enum": ["repeated_trace", "single_trace_candidate"]},
          "status": {"const": "shadow_candidate_not_execution_certified"}
        }
      }
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "hashes": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/hash"}}
  }
}
