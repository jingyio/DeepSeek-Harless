{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "参数化 Motif 局部证明的显式输入绑定",
  "type": "object",
  "required": [
    "schema_version",
    "library_digest",
    "motif_id",
    "operation",
    "items",
    "sources",
    "scope"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "library_digest": {
      "$ref": "#/$defs/sha256"
    },
    "motif_id": {
      "type": "string",
      "pattern": "^parameter-[a-f0-9]{12}$"
    },
    "operation": {
      "enum": [
        "read_files",
        "fetch_arxiv_pages",
        "fetch_crossref_candidates"
      ]
    },
    "scope": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "item_id",
              "file_path",
              "sha256"
            ],
            "additionalProperties": false,
            "properties": {
              "item_id": {
                "type": "string",
                "minLength": 1
              },
              "file_path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "item_id",
              "id",
              "source_path"
            ],
            "additionalProperties": false,
            "properties": {
              "item_id": {
                "type": "string",
                "minLength": 1
              },
              "id": {
                "type": "string",
                "pattern": "^[0-9]{4}\\.[0-9]{4,5}(v[0-9]+)?$"
              },
              "source_path": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "item_id",
              "query",
              "source_path"
            ],
            "properties": {
              "item_id": {
                "type": "string",
                "minLength": 1
              },
              "query": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "source_path": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
