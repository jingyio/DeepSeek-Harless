# 复制为 .env 后填写；.env 已被 Git 忽略。勿在聊天、日志或提交中粘贴密钥。
DEEPSEEK_API_KEY=
# 可只配置 GLM；下面的模型 ID、官方 API 根地址与密钥都由服务器读取。
HARLESS_GLM_API_KEY=
HARLESS_GLM_MODEL=glm-4.6
HARLESS_GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 按所选模型和账户的实际计费填写保守的美元 / 百万 token 单价；缺失时不启用 GLM。
HARLESS_GLM_INPUT_USD_PER_MILLION=
HARLESS_GLM_OUTPUT_USD_PER_MILLION=
# 填写密钥不会自动开始付费；运行 npm run web:real 后，仍须预览确认任务。
